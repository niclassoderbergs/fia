# ---------------------------------------------------------------------------
# Kopiera till .env (lokalt, för importern) och lägg samma värden som
# Environment Variables i Vercel (bara SITE_PASSWORD behövs där).
# ---------------------------------------------------------------------------

# Delat lösenord till webbvyn. Sätts i Vercel → Settings → Environment
# Variables. Utan detta vägrar middleware släppa in någon alls.
SITE_PASSWORD=byt-mig-innan-deploy

# --- eSett open data -------------------------------------------------------

# Bas-URL. Overridas bara i test/mock — eSett har ingen sandbox.
ESETT_BASE_URL=https://api.opendata.esett.com

# Politeness: minsta paus mellan två anrop mot eSett. 6 anrop per körning
# → hela hämtningen tar ~4 min med 45 s paus. Vi äger ingen SLA mot eSett.
ESETT_MIN_DELAY_MS=45000

# Retry vid 429/5xx/nätverksfel. Backoff är kommaseparerade ms-värden;
# antalet försök är antalet steg + 1.
ESETT_RETRY_BACKOFF_MS=60000,240000,960000

# --- Körning ---------------------------------------------------------------

# Slumpat startfönster: körningen sover 0–N minuter innan första anropet så
# vi inte träffar eSett på exakt samma sekund varje dygn.
IMPORT_JITTER_MAX_MINUTES=45

# Massförändringsspärr. Vägrar skriva datafiler om fler än denna andel av
# posterna försvinner i en körning (0.10 = 10 %). Skyddar mot eSett-svar som
# är partiellt trasiga men returnerar 200 OK.
# OBS: siffran är en policy, inte en sanning — sätt den du kan stå för.
IMPORT_MAX_SHRINK_PCT=0.10

# --- Git -------------------------------------------------------------------

IMPORT_GIT_COMMIT=true
IMPORT_GIT_PUSH=true
IMPORT_GIT_REMOTE=origin
IMPORT_GIT_BRANCH=main
